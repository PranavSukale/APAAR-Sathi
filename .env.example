# Owner connection (migrations / create_all / test fixtures). NOT used for app requests.
DATABASE_OWNER_URL=postgresql+psycopg://apaar_owner:apaar_owner_pw@localhost:5544/apaar
# Application role (non-owner, subject to RLS). Created by dbinit.
DATABASE_APP_URL=postgresql+psycopg://apaar_app:apaar_app_pw@localhost:5544/apaar

APP_DB_USER=apaar_app
APP_DB_PASSWORD=apaar_app_pw

# KMS abstraction: local key file dir (auto-generated in dev)
KEY_DIR=backend/keys

# Auth
JWT_SECRET=dev-insecure-change-me
JWT_EXPIRE_MINUTES=720
LOGIN_RATE_MAX=5
LOGIN_RATE_WINDOW_SECONDS=60

# Uploads (BackgroundTasks + local dir instead of Celery/MinIO)
UPLOAD_DIR=uploads

# Optional LLM gateway (disabled by default; stub only)
LLM_ENABLED=false
